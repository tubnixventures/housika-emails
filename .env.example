# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Azure Cosmos DB Configuration (Database: 'emails', Container: 'emails')
COSMOS_ENDPOINT="https://housika-emails.documents.azure.com:443/"
COSMOS_KEY="YOUR_AZURE_COSMOS_PRIMARY_KEY"
COSMOS_DATABASE="emails"
COSMOS_CONTAINER="emails"

# Cloudflare R2 Configuration (S3-compatible bucket for attachments & MIME)
R2_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"
R2_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="housika-email-attachments"
R2_PUBLIC_URL="https://attachments.housika.co.ke"

# Security & Multi-Domain Settings
JWT_SECRET="super-secret-housika-jwt-key-2026-minimum-32-chars"
BASE_DOMAINS="housika.co.ke,housika.com,housika.app"
CF_EMAIL_WORKER_SECRET="cf_webhook_secret_key_housika_2026"

